{
  "agora-quota": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python D:/github/agora/agoralib/quota_hook.py agy-pre",
        "timeout": 15
      }
    ]
  },
  "agora-subagents": {
    "PreToolUse": [
      {
        "matcher": "invoke_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "python D:/github/agora/agoralib/quota_hook.py agy-tool",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "define_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "python D:/github/agora/agoralib/quota_hook.py agy-tool",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "manage_subagents",
        "hooks": [
          {
            "type": "command",
            "command": "python D:/github/agora/agoralib/quota_hook.py agy-tool",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "browser_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "python D:/github/agora/agoralib/quota_hook.py agy-tool",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
