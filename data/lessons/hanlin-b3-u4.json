  "grammar": [
    {
      "id": "u4-g1-verbs-taking-infinitive-or-gerund-as-object",
      "name": "不定詞與動名詞當動詞的受詞",
      "description": "英語動詞依其語義與習慣接不定詞（to V）或動名詞（V-ing）作受詞，用來表達未來的計畫、意願或從事中的活動與喜好。",
      "source_refs": ["handout", "guide"]
    },
    {
      "id": "u4-g2-gerund-as-object-of-preposition",
      "name": "動名詞當介系詞的受詞",
      "description": "介系詞後若需接動作，須將動詞轉化為動名詞（V-ing）形式作為介系詞的受詞。",
      "source_refs": ["handout", "guide"]
    },
    {
      "id": "u4-g3-gerund-subject-and-dummy-it",
      "name": "動名詞當主詞與虛主詞 it",
      "description": "以動名詞片語作為句子的主詞並視為單數；亦可使用代名詞 it 作為形式上的虛主詞，將真主詞的不定詞或動名詞片語移至句尾以平衡句式。",
